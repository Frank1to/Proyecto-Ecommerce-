# Copiá este archivo a ".env" (mismo directorio) y completá tus claves de TEST.
# El archivo ".env" nunca se sube a git (ver .gitignore).

# URL pública del sitio (usada para armar success_url/cancel_url/webhooks).
# En desarrollo local con el servidor de Django podés dejar la de abajo.
# Para probar webhooks de verdad necesitás una URL pública (ver ngrok más abajo).
SITE_URL=http://127.0.0.1:8000

# --- Stripe (https://dashboard.stripe.com/test/apikeys) ---
STRIPE_PUBLISHABLE_KEY=pega-aqui-tu-publishable-key-de-stripe
STRIPE_SECRET_KEY=pega-aqui-tu-secret-key-de-stripe
# Se obtiene al correr `stripe listen --forward-to localhost:8000/webhooks/stripe/`
STRIPE_WEBHOOK_SECRET=pega-aqui-tu-webhook-secret-de-stripe

# --- MercadoPago (https://www.mercadopago.com.py/developers/panel/app) ---
MERCADOPAGO_PUBLIC_KEY=pega-aqui-tu-public-key-de-mercadopago
MERCADOPAGO_ACCESS_TOKEN=pega-aqui-tu-access-token-de-mercadopago
